<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.TextField?>
<BorderPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ChatController" nodeOrientation="RIGHT_TO_LEFT">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Button onAction="#goBack" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-right" iconSize="18" iconColor="#2d3748"/>
                </graphic>
            </Button>
            <VBox spacing="1" alignment="CENTER">
                <Text  fx:id="chatTitle" text="چت"
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2d3748;"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox style="-fx-background-color: #e8edf2;" VBox.vgrow="ALWAYS">
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="messagesContainer" spacing="8" style="-fx-padding: 15;"/>
            </ScrollPane>

            <!-- Message Input -->
            <HBox spacing="8" alignment="CENTER"
                  style="-fx-padding: 10 15; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
                <TextField fx:id="messageField" promptText="پیام خود را بنویسید..." styleClass="input-field"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-font-size: 13px;"/>
                <Button onAction="#onSendMessage" minHeight="40"
                        style="-fx-background-color: #4fa8f6; -fx-background-radius: 50%; -fx-padding: 0; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(79, 168, 246, 0.4), 8, 0, 0, 4);">
                    <graphic>
                        <FontIcon iconLiteral="fas-paper-plane" iconSize="16" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>