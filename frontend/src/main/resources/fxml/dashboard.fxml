<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">
    <top>
        <fx:include source="components/header.fxml" />
    </top>
    <center>
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #f0f4f8; -fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="input-container" HBox.hgrow="ALWAYS">
                    <FontIcon iconCode="SEARCH" iconSize="16" iconColor="#718096" />
                    <TextField fx:id="searchField" promptText="جستجوی آگهی..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                </HBox>
                <Button styleClass="primary-btn" onAction="#onSearch">
                    <graphic>
                        <FontIcon iconCode="SEARCH" iconSize="16" />
                    </graphic>
                </Button>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <FlowPane fx:id="adFlowPane" alignment="TOP_LEFT" hgap="15" vgap="15" />
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>