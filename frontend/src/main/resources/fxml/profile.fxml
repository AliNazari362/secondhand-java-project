<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController">

    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
        <padding><Insets top="15" right="25" bottom="15" left="25" /></padding>
        <Text text="👤 پروفایل کاربر" styleClass="header-title" />
        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Button text="🔙 بازگشت" styleClass="secondary-btn" onAction="#goBack" />
        </HBox>
    </HBox>

    <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">

        <VBox styleClass="card" spacing="15" prefWidth="500">

            <Text text="اطلاعات شخصی" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2d3748;" />

            <TextField fx:id="fullNameField" promptText="نام کامل" styleClass="input-field" />
            <TextField fx:id="emailField" promptText="آدرس ایمیل" styleClass="input-field" />
            <TextField fx:id="phoneField" promptText="شماره تماس" styleClass="input-field" />

            <Button text="💾 ذخیره تغییرات" styleClass="success-btn" onAction="#onUpdateProfile" />

            <Text text="تغییر رمز عبور" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748; -fx-padding: 10 0 0 0;" />

            <PasswordField fx:id="currentPasswordField" promptText="رمز عبور فعلی" styleClass="input-field" />
            <PasswordField fx:id="newPasswordField" promptText="رمز عبور جدید" styleClass="input-field" />

            <Button text="🔑 تغییر رمز عبور" styleClass="primary-btn" onAction="#onChangePassword" />

            <Button text="🗑️ حذف حساب کاربری" styleClass="danger-btn" onAction="#onDeleteAccount" />

        </VBox>

    </VBox>
</VBox>