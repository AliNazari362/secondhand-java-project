<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminController">
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
        <padding><Insets top="15" right="25" bottom="15" left="25" /></padding>
        <FontIcon iconCode="COG" iconSize="20" iconColor="#2d3748" />
        <Text text="پنل مدیریت" styleClass="header-title" />
        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Button onAction="#goBack">
                <graphic><FontIcon iconCode="ARROW_LEFT" iconSize="16" /></graphic>
            </Button>
        </HBox>
    </HBox>
    <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">
        <VBox styleClass="card" spacing="15" prefWidth="800">
            <TabPane fx:id="tabPane" styleClass="tab-pane">
                <Tab text="آگهی‌های در انتظار" closable="false">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <ListView fx:id="pendingListView" styleClass="list-view" prefHeight="350" />
                        <HBox spacing="10" alignment="CENTER">
                            <Button onAction="#onApproveAd">
                                <graphic><FontIcon iconCode="CHECK" iconSize="16" /></graphic>
                            </Button>
                            <Button onAction="#onRejectAd" styleClass="danger-btn">
                                <graphic><FontIcon iconCode="TIMES" iconSize="16" /></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="کاربران" closable="false">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <ListView fx:id="usersListView" styleClass="list-view" prefHeight="350" />
                        <HBox spacing="10" alignment="CENTER">
                            <Button onAction="#onBanUser" styleClass="danger-btn">
                                <graphic><FontIcon iconCode="BAN" iconSize="16" /></graphic>
                            </Button>
                            <Button onAction="#onUnbanUser">
                                <graphic><FontIcon iconCode="CHECK_CIRCLE" iconSize="16" /></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </VBox>
</VBox>