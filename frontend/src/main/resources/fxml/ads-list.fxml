<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<BorderPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.FavoritesController" nodeOrientation="RIGHT_TO_LEFT">
    <top>
        <!-- TODO implement user section-->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="10">
                <FontIcon iconLiteral="fas-store-alt" iconSize="24" iconColor="#2d3748"/>
                <VBox spacing="2">
                    <Text text="خرید و فروش آسان" styleClass="header-title"/>
                    <Text text="دست دوم" styleClass="header-subtitle">
                        <fill>
                            <LinearGradient>
                                <stops>
                                    <Stop color="#e53e3e"/>
                                    <Stop color="#dd6b20" offset="1.0"/>
                                </stops>
                            </LinearGradient>
                        </fill>
                    </Text>
                </VBox>
            </HBox>

            <!-- سمت چپ: پروفایل کاربر -->
            <Button styleClass="profile-btn">
                <graphic>
                    <HBox spacing="8" alignment="CENTER">
                        <FontIcon iconLiteral="fas-user-circle" iconSize="20" iconColor="#4a5568"/>
                        <Text text="حساب کاربری" styleClass="profile-text"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">
                <FlowPane fx:id="adFlowPane" alignment="TOP_RIGHT" hgap="15" vgap="15"/>

                <!-- Sample Ad Cards for Preview -->
                <FlowPane alignment="TOP_RIGHT" hgap="15" vgap="15">

                    <!-- Sample Product Card 1 -->
                    <VBox spacing="8"
                          style="-fx-padding: 0; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-max-width: 220; -fx-min-width: 220;"
                          VBox.vgrow="NEVER">
                        <VBox spacing="0" alignment="CENTER"
                              style="-fx-padding: 20; -fx-background-color: #f7fafc; -fx-background-radius: 10 10 0 0; -fx-min-height: 150;">
                            <FontIcon iconLiteral="fas-image" iconSize="56" iconColor="#a0aec0"/>
                            <Text text="تصویر آگهی" style="-fx-font-size: 11px; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <VBox spacing="6" style="-fx-padding: 10 12 12 12;">
                            <Text text="آیفون ۱۳ پرو مکس ۲۵۶ گیگ"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #2d3748;"
                                  wrappingWidth="180"/>
                            <Text text="۳۵,۰۰۰,۰۰۰ تومان"
                                  style="-fx-font-size: 15px; -fx-fill: #38a169; -fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="11" iconColor="#a0aec0"/>
                                <Text text="تهران" style="-fx-font-size: 11px; -fx-fill: #718096;"/>
                            </HBox>
                            <Button text="مشاهده آگهی" styleClass="primary-btn" maxWidth="1.7976931348623157E308">
                                <graphic>
                                    <FontIcon iconLiteral="fas-eye" iconSize="14"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- Sample Service Card 2 -->
                    <VBox spacing="8"
                          style="-fx-padding: 0; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-max-width: 220; -fx-min-width: 220;"
                          VBox.vgrow="NEVER">
                        <VBox spacing="0" alignment="CENTER"
                              style="-fx-padding: 20; -fx-background-color: #f7fafc; -fx-background-radius: 10 10 0 0; -fx-min-height: 150;">
                            <FontIcon iconLiteral="fas-image" iconSize="56" iconColor="#a0aec0"/>
                            <Text text="تصویر آگهی" style="-fx-font-size: 11px; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <VBox spacing="6" style="-fx-padding: 10 12 12 12;">
                            <Text text="تعمیرات موبایل و تبلت"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #2d3748;"
                                  wrappingWidth="180"/>
                            <Text text="۵۰۰,۰۰۰ تومان / ساعتی"
                                  style="-fx-font-size: 15px; -fx-fill: #38a169; -fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="11" iconColor="#a0aec0"/>
                                <Text text="اصفهان" style="-fx-font-size: 11px; -fx-fill: #718096;"/>
                            </HBox>
                            <Button text="مشاهده آگهی" styleClass="primary-btn" maxWidth="1.7976931348623157E308">
                                <graphic>
                                    <FontIcon iconLiteral="fas-eye" iconSize="14"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- Sample Product Card 3 -->
                    <VBox spacing="8"
                          style="-fx-padding: 0; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-max-width: 220; -fx-min-width: 220;"
                          VBox.vgrow="NEVER">
                        <VBox spacing="0" alignment="CENTER"
                              style="-fx-padding: 20; -fx-background-color: #f7fafc; -fx-background-radius: 10 10 0 0; -fx-min-height: 150;">
                            <FontIcon iconLiteral="fas-image" iconSize="56" iconColor="#a0aec0"/>
                            <Text text="تصویر آگهی" style="-fx-font-size: 11px; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <VBox spacing="6" style="-fx-padding: 10 12 12 12;">
                            <Text text="میز کار چوبی مدرن"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #2d3748;"
                                  wrappingWidth="180"/>
                            <Text text="۴,۲۰۰,۰۰۰ تومان"
                                  style="-fx-font-size: 15px; -fx-fill: #38a169; -fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="11" iconColor="#a0aec0"/>
                                <Text text="شیراز" style="-fx-font-size: 11px; -fx-fill: #718096;"/>
                            </HBox>
                            <Button text="مشاهده آگهی" styleClass="primary-btn" maxWidth="1.7976931348623157E308">
                                <graphic>
                                    <FontIcon iconLiteral="fas-eye" iconSize="14"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- Sample Service Card 4 -->
                    <VBox spacing="8"
                          style="-fx-padding: 0; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-max-width: 220; -fx-min-width: 220;"
                          VBox.vgrow="NEVER">
                        <VBox spacing="0" alignment="CENTER"
                              style="-fx-padding: 20; -fx-background-color: #f7fafc; -fx-background-radius: 10 10 0 0; -fx-min-height: 150;">
                            <FontIcon iconLiteral="fas-image" iconSize="56" iconColor="#a0aec0"/>
                            <Text text="تصویر آگهی" style="-fx-font-size: 11px; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <VBox spacing="6" style="-fx-padding: 10 12 12 12;">
                            <Text text="تدریس خصوصی ریاضی"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #2d3748;"
                                  wrappingWidth="180"/>
                            <Text text="۳۰۰,۰۰۰ تومان / جلسه"
                                  style="-fx-font-size: 15px; -fx-fill: #38a169; -fx-font-weight: bold;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="11" iconColor="#a0aec0"/>
                                <Text text="مشهد" style="-fx-font-size: 11px; -fx-fill: #718096;"/>
                            </HBox>
                            <Button text="مشاهده آگهی" styleClass="primary-btn" maxWidth="1.7976931348623157E308">
                                <graphic>
                                    <FontIcon iconLiteral="fas-eye" iconSize="14"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>