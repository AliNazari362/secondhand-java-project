<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FavoritesController">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
            <padding><Insets top="15" right="25" bottom="15" left="25" /></padding>
            <FontIcon iconCode="HEART" iconSize="20" iconColor="#e53e3e" />
            <Text text="علاقه‌مندی‌ها" styleClass="header-title" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Button onAction="#goBack">
                    <graphic><FontIcon iconCode="ARROW_LEFT" iconSize="16" /></graphic>
                </Button>
            </HBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">
                <FlowPane fx:id="favoritesFlowPane" alignment="TOP_LEFT" hgap="15" vgap="15" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>