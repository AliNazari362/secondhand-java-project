<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox styleClass="ad-card" spacing="5" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.AdCardController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <!-- تصویر -->
    <ImageView fx:id="imageView" fitWidth="180" fitHeight="120" preserveRatio="true" style="-fx-background-color: #f7fafc; -fx-background-radius: 8;" />

    <!-- عنوان -->
    <Text fx:id="titleText" styleClass="ad-title" wrappingWidth="170" />

    <!-- قیمت -->
    <Label fx:id="priceLabel" styleClass="ad-price" />

    <!-- شهر -->
    <Label fx:id="cityLabel" styleClass="ad-city" />

    <!-- دسته‌بندی -->
    <Label fx:id="categoryLabel" style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold; -fx-padding: 2 8; -fx-background-color: #edf2f7; -fx-background-radius: 10;" />

    <!-- تاریخ -->
    <Label fx:id="dateLabel" styleClass="ad-date" />
</VBox>