<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox styleClass="ad-card" spacing="5" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.AdCardController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Text fx:id="titleText" styleClass="ad-title" />
    <Label fx:id="priceLabel" styleClass="ad-price" />
    <Label fx:id="cityLabel" styleClass="ad-city" />
    <Label fx:id="dateLabel" styleClass="ad-date" />
</VBox>