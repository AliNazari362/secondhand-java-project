<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10" styleClass="sidebar" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.SidebarController">
    <padding>
        <Insets top="20" right="15" bottom="20" left="15" />
    </padding>

    <Text text="منو" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748;" />

    <Button onAction="#onDashboard">
        <graphic><FontIcon iconCode="HOME" iconSize="16" /></graphic>
    </Button>
    <Button onAction="#onNewAd">
        <graphic><FontIcon iconCode="PLUS" iconSize="16" /></graphic>
    </Button>
    <Button onAction="#onFavorites">
        <graphic><FontIcon iconCode="HEART" iconSize="16" /></graphic>
    </Button>
    <Button onAction="#onChat">
        <graphic><FontIcon iconCode="COMMENT" iconSize="16" /></graphic>
    </Button>
    <Button onAction="#onProfile">
        <graphic><FontIcon iconCode="USER" iconSize="16" /></graphic>
    </Button>

    <Button onAction="#onLogout" styleClass="danger-btn" VBox.vgrow="ALWAYS">
        <graphic><FontIcon iconCode="SIGN_OUT_ALT" iconSize="16" /></graphic>
    </Button>
</VBox>