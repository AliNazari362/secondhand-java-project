<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="10" styleClass="sidebar" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.SidebarController">
    <padding>
        <Insets top="20" right="15" bottom="20" left="15" />
    </padding>

    <Text text="📋 منو" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748;" />

    <Button text="📊 داشبورد" styleClass="sidebar-btn" onAction="#onDashboard" />
    <Button text="➕ آگهی جدید" styleClass="sidebar-btn" onAction="#onNewAd" />
    <Button text="❤️ علاقه‌مندی‌ها" styleClass="sidebar-btn" onAction="#onFavorites" />
    <Button text="💬 پیام‌ها" styleClass="sidebar-btn" onAction="#onChat" />
    <Button text="👤 پروفایل" styleClass="sidebar-btn" onAction="#onProfile" />

    <Button text="🚪 خروج" styleClass="sidebar-btn danger-btn" onAction="#onLogout" VBox.vgrow="ALWAYS" />
</VBox>