<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="15" alignment="CENTER_LEFT" styleClass="header" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.HeaderController">
    <padding>
        <Insets top="15" right="25" bottom="15" left="25" />
    </padding>

    <Text fx:id="titleText" text="لیست آگهی ها" styleClass="header-title" />
    <Text fx:id="userInfoText" text="خوش آمدید، کاربر" styleClass="header-subtitle" />

    <HBox spacing="10" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
        <Button onAction="#onNewAd">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="16" /></graphic>
        </Button>
        <Button onAction="#onFavorites">
            <graphic><FontIcon iconLiteral="fas-heart" iconSize="16" /></graphic>
        </Button>
        <Button onAction="#onChat">
            <graphic><FontIcon iconLiteral="fas-comment" iconSize="16" /></graphic>
        </Button>

        <!-- دکمه پروفایل (حساب کاربری) -->
        <Button onAction="#onProfile">
            <graphic><FontIcon iconLiteral="fas-user-circle" iconSize="16" /></graphic>
        </Button>

        <Button fx:id="adminBtn" onAction="#onAdmin" visible="false">
            <graphic><FontIcon iconLiteral="fas-cog" iconSize="16" /></graphic>
        </Button>
        <Button onAction="#onLogout">
            <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" /></graphic>
        </Button>
    </HBox>
</HBox>