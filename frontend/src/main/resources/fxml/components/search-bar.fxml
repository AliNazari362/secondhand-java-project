<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="10" alignment="CENTER" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="component.SearchBarController">
    <TextField fx:id="searchField" promptText="جستجو..." styleClass="input-field" HBox.hgrow="ALWAYS" />
    <Button onAction="#onSearch">
        <graphic><FontIcon iconLiteral="fas-search" iconSize="16" /></graphic>
    </Button>
</HBox>