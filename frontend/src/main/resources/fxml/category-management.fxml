<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CategoryManagementController">
    <!-- Header -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
        <padding><Insets top="15" right="25" bottom="15" left="25" /></padding>
        <FontIcon iconLiteral="fas-tags" iconSize="20" iconColor="#2d3748" />
        <Text text="مدیریت دسته‌بندی‌ها" styleClass="header-title" />
        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Button onAction="#goBack">
                <graphic><FontIcon iconLiteral="fas-arrow-left" iconSize="16" /></graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Content -->
    <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;" VBox.vgrow="ALWAYS">
        <HBox spacing="15" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

            <!-- Tree View -->
            <VBox spacing="10" styleClass="card" prefWidth="400" VBox.vgrow="ALWAYS">
                <Text text="درخت دسته‌بندی‌ها" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748;" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent;">
                    <TreeView fx:id="categoryTreeView" VBox.vgrow="ALWAYS" />
                </ScrollPane>
                <HBox spacing="10" alignment="CENTER">
                    <Button onAction="#onAddRoot" styleClass="success-btn">
                        <graphic><FontIcon iconLiteral="fas-plus" iconSize="16" /></graphic>
                    </Button>
                    <Button onAction="#onClear" styleClass="secondary-btn">
                        <graphic><FontIcon iconLiteral="fas-times" iconSize="16" /></graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Form -->
            <VBox spacing="15" styleClass="card" prefWidth="350" VBox.vgrow="ALWAYS">
                <Text text="ویرایش/ایجاد دسته‌بندی" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748;" />

                <Label fx:id="selectedCategoryLabel" text="هیچ دسته‌بندی انتخاب نشده است." style="-fx-font-size: 13px; -fx-text-fill: #718096;" />

                <VBox spacing="5">
                    <Label text="نام دسته‌بندی:" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                    <TextField fx:id="nameField" promptText="نام دسته‌بندی" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="نوع:" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                    <ComboBox fx:id="typeComboBox" promptText="نوع" styleClass="input-field" maxWidth="1.7976931348623157E308" />
                </VBox>

                <VBox spacing="5">
                    <Label text="والد:" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                    <ComboBox fx:id="parentComboBox" promptText="بدون والد (ریشه)" styleClass="input-field" maxWidth="1.7976931348623157E308" />
                </VBox>

                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button fx:id="saveButton" onAction="#onSave" styleClass="success-btn">
                        <graphic><FontIcon iconLiteral="fas-save" iconSize="16" /></graphic>
                    </Button>
                    <Button fx:id="deleteButton" onAction="#onDelete" styleClass="danger-btn">
                        <graphic><FontIcon iconLiteral="fas-trash" iconSize="16" /></graphic>
                    </Button>
                </HBox>
            </VBox>

        </HBox>
    </VBox>
</VBox>