<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- New advertisement creation view -->
<VBox stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.NewAdController" nodeOrientation="RIGHT_TO_LEFT">
    <!-- Top header bar -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
        <padding>
            <Insets top="15" right="25" bottom="15" left="25"/>
        </padding>
        <FontIcon iconLiteral="fas-plus" iconSize="20" iconColor="#2d3748"/>
        <Text text="ثبت آگهی جدید" styleClass="header-title"/>
        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <!-- Cancel button -->
            <Button onAction="#onCancel">
                <graphic>
                    <FontIcon iconLiteral="fas-times" iconSize="16"/>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Scrollable form content -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">
            <!-- Main form card -->
            <VBox styleClass="card" spacing="20" prefWidth="700.0">
                <Text text="اطلاعات آگهی" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2d3748;"/>

                <!-- Image Upload Section -->
                <VBox spacing="10" alignment="CENTER"
                      style="-fx-padding: 15; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-color: #f7fafc; -fx-background-radius: 8;">
                    <FontIcon iconLiteral="fas-cloud-upload-alt" iconSize="36" iconColor="#a0aec0"/>
                    <Text text="تصاویر آگهی را اینجا بارگذاری کنید" style="-fx-font-size: 13px; -fx-fill: #718096;"/>
                    <Text text="فرمت های مجاز: JPG, PNG, GIF, BMP, WEBP (حداکثر ۵ عکس)"
                          style="-fx-font-size: 11px; -fx-fill: #a0aec0;"/>
                    <!-- Image selection button -->
                    <Button text="انتخاب تصاویر" onAction="#onChooseImages" styleClass="success-btn">
                        <graphic>
                            <FontIcon iconLiteral="fas-images" iconSize="16"/>
                        </graphic>
                    </Button>
                    <!-- Image preview container -->
                    <FlowPane fx:id="imagePreviewContainer" hgap="10" vgap="10" style="-fx-padding: 10 0 0 0;" />
                </VBox>

                <!-- Title input -->
                <VBox spacing="5">
                    <Text text="عنوان آگهی" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                    <TextField fx:id="titleField" promptText="عنوان آگهی *" styleClass="ad-form-input"/>
                </VBox>

                <!-- Description input -->
                <VBox spacing="5">
                    <Text text="توضیحات" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                    <TextArea fx:id="descArea" promptText="توضیحات کامل *" styleClass="text-area-field"
                              prefHeight="120.0" wrapText="true"/>
                </VBox>

                <!-- City selection -->
                <VBox spacing="5">
                    <Text text="شهر" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cityCombo" promptText="شهر *" styleClass="ad-form-input"
                              maxWidth="1.7976931348623157E308"/>
                </VBox>

                <!-- Address input -->
                <VBox spacing="5">
                    <Text text="آدرس" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                    <TextField fx:id="addressField" promptText="آدرس *" styleClass="ad-form-input"/>
                </VBox>

                <!-- Ad Type Selection -->
                <VBox spacing="5">
                    <Text text="نوع آگهی" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2d3748;"/>
                    <ComboBox fx:id="typeCombo" onAction="#onChooseType" promptText="انتخاب نوع آگهی (خدمت یا کالا) *"
                              styleClass="ad-form-input"
                              maxWidth="1.7976931348623157E308"/>
                </VBox>

                <!-- Category selection (common for both ad types) -->
                <VBox spacing="5">
                    <Text text="دسته‌بندی" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="categoryCombo" promptText="انتخاب دسته‌بندی *" styleClass="ad-form-input"
                              maxWidth="1.7976931348623157E308"/>
                </VBox>

                <!-- Service-specific Fields Section -->
                <VBox fx:id="serviceFields" spacing="15">
                    <Text text="جزئیات خدمت"
                          style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-fill: #2d3748; -fx-padding: 5 0 0 0;"/>
                    <!-- Service calculation type -->
                    <VBox spacing="5">
                        <Text text="نوع محاسبه خدمت"
                              style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="serviceCalcTypeCombo" promptText="نوع محاسبه خدمت *" styleClass="ad-form-input"
                                  maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <!-- Service price per unit -->
                    <VBox spacing="5">
                        <Text text="هزینه ارائه خدمت"
                              style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <TextField fx:id="servicePriceField" promptText="هزینه ارائه خدمت در هر پارت *"
                                   styleClass="ad-form-input"/>
                    </VBox>
                </VBox>

                <!-- Product-specific Fields Section -->
                <VBox fx:id="productFields" spacing="15">
                    <Text text="جزئیات کالا"
                          style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-fill: #2d3748; -fx-padding: 5 0 0 0;"/>
                    <!-- Product price -->
                    <VBox spacing="5">
                        <Text text="قیمت" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <TextField fx:id="productPriceField" promptText="قیمت (تومان) *" styleClass="ad-form-input"/>
                    </VBox>
                    <!-- Product condition -->
                    <VBox spacing="5">
                        <Text text="وضعیت محصول"
                              style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="productConditionCombo" promptText="وضعیت محصول *" styleClass="ad-form-input"
                                  maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <!-- Brand -->
                    <VBox spacing="5">
                        <Text text="برند" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <TextField fx:id="brandField" promptText="برند" styleClass="ad-form-input"/>
                    </VBox>
                    <!-- Model -->
                    <VBox spacing="5">
                        <Text text="مدل" style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <TextField fx:id="modelField" promptText="مدل" styleClass="ad-form-input"/>
                    </VBox>
                    <!-- Manufacturer/Designer -->
                    <VBox spacing="5">
                        <Text text="سازنده یا طراح"
                              style="-fx-font-size: 13px; -fx-fill: #4a5568; -fx-font-weight: bold;"/>
                        <TextField fx:id="manufacturerField" promptText="سازنده یا طراح" styleClass="ad-form-input"/>
                    </VBox>
                </VBox>

                <!-- Add custom features Section -->
                <VBox spacing="10">
                    <Text text="ویژگی های اضافی"
                          style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-fill: #2d3748; -fx-padding: 5 0 0 0;"/>
                    <!-- Add new feature button -->
                    <Button onAction="#handleAddFeature" text="افزودن ویژگی جدید" styleClass="primary-btn" maxWidth="200">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus-circle" iconSize="16"/>
                        </graphic>
                    </Button>
                    <!-- Dynamic features container -->
                    <VBox fx:id="optionsContainer" spacing="10"/>
                </VBox>

                <!-- Submit and Cancel buttons -->
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <!-- Submit ad button -->
                    <Button text="ثبت آگهی" onAction="#onSubmit" styleClass="success-btn">
                        <graphic>
                            <FontIcon iconLiteral="fas-check-circle" iconSize="16"/>
                        </graphic>
                    </Button>
                    <!-- Cancel button -->
                    <Button text="انصراف" onAction="#onCancel" styleClass="danger-btn">
                        <graphic>
                            <FontIcon iconLiteral="fas-times" iconSize="16"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>