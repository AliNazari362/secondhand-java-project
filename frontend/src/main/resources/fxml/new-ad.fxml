<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NewAdController">

    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
        <padding><Insets top="15" right="25" bottom="15" left="25" /></padding>
        <Text text="📝 ثبت آگهی جدید" styleClass="header-title" />
        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Button text="🔙 بازگشت" styleClass="secondary-btn" onAction="#onCancel" />
        </HBox>
    </HBox>

    <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 25; -fx-background-color: #f0f4f8;">

        <VBox styleClass="card" spacing="20" prefWidth="700">

            <Text text="اطلاعات آگهی" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2d3748;" />

            <TextField fx:id="titleField" promptText="عنوان آگهی *" styleClass="input-field" />
            <TextArea fx:id="descArea" promptText="توضیحات کامل *" styleClass="text-area-field" prefHeight="120" wrapText="true" />
            <TextField fx:id="priceField" promptText="قیمت (تومان) *" styleClass="input-field" />

            <ComboBox fx:id="cityCombo" promptText="شهر *" styleClass="input-field" maxWidth="Double.MAX_VALUE" />
            <ComboBox fx:id="typeCombo" promptText="نوع آگهی *" styleClass="input-field" maxWidth="Double.MAX_VALUE" />

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="imagePathField" promptText="مسیر تصویر" styleClass="input-field" HBox.hgrow="ALWAYS" editable="false" />
                <Button text="📷 انتخاب تصویر" styleClass="secondary-btn" onAction="#onChooseImage" />
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Button text="📤 ثبت آگهی" styleClass="success-btn" onAction="#onSubmit" />
                <Button text="❌ انصراف" styleClass="secondary-btn" onAction="#onCancel" />
            </HBox>

        </VBox>

    </VBox>
</VBox>